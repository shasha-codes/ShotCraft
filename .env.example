# Copy this file to .env for local development.
AWS_PROFILE=strands-dev
AWS_REGION=us-west-2
# For local Bedrock API-key authentication, set this instead of AWS_PROFILE.
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
SHOTCRAFT_MODEL=openai.gpt-oss-120b-1:0
# The Bedrock console's OpenAI-compatible API-key quickstart uses Mantle.
# SHOTCRAFT_BEDROCK_ENDPOINT=https://bedrock-mantle.us-west-2.api.aws/v1
SHOTCRAFT_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_API_KEY=your_openai_api_key
# Optional durable storage for generated moodboard images. Without a bucket,
# images are stored locally. S3 failures also fall back to local storage.
# SHOTCRAFT_IMAGE_S3_BUCKET=your-private-bucket
# SHOTCRAFT_IMAGE_S3_PREFIX=generated/
# Route Strands workflows through the deployed AgentCore runtime.
# SHOTCRAFT_AGENTCORE_ENABLED=true
# SHOTCRAFT_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:ACCOUNT_ID:runtime/RUNTIME_ID
